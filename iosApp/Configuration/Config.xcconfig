TEAM_ID=

PRODUCT_NAME=ComposeMultiplatform
PRODUCT_BUNDLE_IDENTIFIER=com.kturker.composemultiplatform.ComposeMultiplatform$(TEAM_ID)
// cmpose:backend

// Google Sign-In's callback URL scheme: REVERSED_CLIENT_ID from GoogleService-Info.plist; Info.plist
// registers it. Empty until set, and Google sign-in cannot return to the app without it.
GOOGLE_REVERSED_CLIENT_ID=
// /cmpose:backend

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
OTHER_LDFLAGS = $(inherited) -lsqlite3